        </Question>
        <redcap:Calculation>if([hl_age_sc]&gt;=75,2,0) + if([hl_hosp6m_sc]="1",3,0) + if([hl_egfr_sc]&lt;45,2,0) + if(([hl_np_type_sc]="1" and [hl_np_value_sc]&gt;=500) or ([hl_np_type_sc]="2" and [hl_np_value_sc]&gt;=1500),2,0) + if([hl_sbp_sc]&lt;100,2,0) + if([hl_diabetes_sc]="1",1,0) + if([hl_lvef_sc]&lt;30,2,0) + if([hl_ckm_sc]&gt;=3,2,0) + if([hl_cardio_distance_sc]&gt;50,1,0) + if([hl_limited_support_sc]="1",1,0)</redcap:Calculation>
